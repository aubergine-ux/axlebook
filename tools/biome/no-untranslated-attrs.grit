// Axlebook i18n guard: user-visible JSX attributes must not be hardcoded strings.
// Complements Biome's built-in style/noJsxLiterals, which only checks text children.
// Empty strings are allowed (alt="" marks a decorative image).
language js

JsxAttribute(name=$name, initializer=JsxAttributeInitializerClause(value=$value)) as $attr where {
  $value <: JsxString(),
  $value <: not r"^[\"'][\"']$",
  $name <: or {
    `aria-label`,
    `aria-description`,
    `aria-placeholder`,
    `aria-valuetext`,
    `placeholder`,
    `title`,
    `alt`,
    `label`
  },
  register_diagnostic(span=$attr, message="Hardcoded user-visible text in a JSX attribute. Use t('…') from react-i18next.", severity="error")
}
