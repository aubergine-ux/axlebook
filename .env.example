# Axlebook configuration. Copy to `.env` and adjust; every variable is optional.
# Docker Compose picks up `.env` automatically. Full reference: README.md → Configuration.

# ── Server ───────────────────────────────────────────────────────────────────
# Port inside the container (map it with AXLEBOOK_PORT in docker-compose.yml).
# PORT=8080
# Host port published by docker-compose.yml.
# AXLEBOOK_PORT=8080
# Public URL users reach Axlebook at. Strongly recommended behind a reverse proxy:
# it pins the CSRF origin check and is used for links in emails and OIDC callbacks.
# BASE_URL=https://cars.example.com
# Trust X-Forwarded-* headers from a reverse proxy (true/false).
# TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# ── Storage ──────────────────────────────────────────────────────────────────
# Where the SQLite database and attachments are stored (the Docker volume).
# DATA_DIR=/data
# Leave unset for SQLite. Set a Postgres URL to use Postgres instead.
# DATABASE_URL=postgres://axlebook:secret@db:5432/axlebook
# Maximum size of one uploaded attachment, in megabytes.
# MAX_UPLOAD_MB=25

# ── Defaults ─────────────────────────────────────────────────────────────────
# Unit system for new users: imperial | metric
# DEFAULT_UNIT_SYSTEM=imperial
# ISO 4217 currency code used across the instance (admins can change it later).
# DEFAULT_CURRENCY=USD
# Interface language for new users.
# DEFAULT_LOCALE=en

# ── Demo ─────────────────────────────────────────────────────────────────────
# Seed two demo vehicles with history on startup (skipped if they already exist).
# SEED_DEMO_DATA=false
